# Ignore everything
/*
.*

# Allow specific top-level dotfiles
!/.bash_logout
!/.bash_profile
!/.bashrc
!/.deno
!/.profile
!/.zprofile
!/CLAUDE.md

# Allow only specific .ssh file
!/.ssh/
!/.ssh/config

# Explicitly ignore other .ssh files
.ssh/*
!.ssh/config

# Allow .config folder
!/.config/

# Allow .local/bin and its contents
!.local/
!.local/bin/
!.local/bin/**
# Re-ignore everything else under .local/
.local/*
!.local/bin/

# Ignore everything inside it
/.config/*

# Allow only specific subfolders
!/.config/Code/
!/.config/Code/**
!/.config/gitui/
!/.config/gitui/**
!/.config/ghostty/
!/.config/ghostty/**
!/.config/helix/
!/.config/helix/**
!/.config/hypr/
!/.config/hypr/**
!/.config/iterm2/
!/.config/iterm2/**
!/.config/omarchy/
!/.config/omarchy/**
!/.config/starship.toml
!/.config/swayosd/
!/.config/swayosd/**
!/.config/tmux/
!/.config/tmux/**
!/.config/waybar/
!/.config/waybar/**
!/.config/weechat/
!/.config/weechat/**
# The terminal picked by xdg-terminal-exec, which drives SUPER + RETURN and
# SUPER + ALT + RETURN. Tracked so the choice follows the dotfiles.
!/.config/xdg-terminals.list
!/.config/restic/
!/.config/restic/excludes
!/.config/systemd/
!/.config/systemd/user/
# Re-ignore the contents so only the units listed below are trackable. Without
# this line the two rules above open the whole directory: systemd writes its
# own enablement symlinks (*.target.wants/) and drop-ins (*.service.d/) in
# here, and `git add -A .config/systemd` would sweep them all in.
/.config/systemd/user/*
!/.config/systemd/user/backup.service
!/.config/systemd/user/backup.timer
!/.config/systemd/user/standup.service
!/.config/systemd/user/standup.timer
!/.config/systemd/user/vdirsyncer-sync.service
!/.config/systemd/user/vdirsyncer-sync.timer
!/.config/systemd/user/khal-notify.service
!/.config/systemd/user/khal-notify.timer
!/.config/systemd/user/minipc-monitor.service
!/.config/systemd/user/minipc-monitor.timer
!/.config/nvim/
!/.config/nvim/**

# ❌ Ignore this explicitly
.config/systemd/user/timers.target.wants/
.config/nvim/.nvimlog
.config/nvim/profile.log
.config/nvim/lazyvim.json
.config/nvim/lazy-lock.json
.config/nvim/queries/
.config/github-copilot/
.config/hypr/shaders/
.config/hypr/monitors.conf
.local/bin/claude
.local/bin/env
.local/bin/env.fish
.local/bin/pynvim-python
.local/bin/uv
.local/bin/uvx
.zshrc.local

# Allow .claude folder
!/.claude/
# Ignore everything inside it
.claude/*
# Allow only specific files
!/.claude/settings.json
!/.claude/statusline.sh
!/.claude/hooks/
!/.claude/hooks/*.sh

# Allow only listed .emacs.d content
!/.emacs.d/
!/.emacs.d/dashboard.el
!/.emacs.d/email.el
!/.emacs.d/fira-code.el
!/.emacs.d/init.el
!/.emacs.d/javascript.el
!/.emacs.d/packages.el
!/.emacs.d/python.el
!/.emacs.d/rust.el
!/.emacs.d/settings.el
!/.emacs.d/shell.el
!/.emacs.d/snippets/**
!/.emacs.d/variables.el

# ❌ Explicitly ignore .emacs.d garbage
.emacs.d/backups/
.emacs.d/bookmarks
.emacs.d/elpa/
.emacs.d/eln-cache/
.emacs.d/projects
.emacs.d/quelpa/
.emacs.d/recentf
.emacs.d/transient/
.emacs.d/tree-sitter/

# Allow .gemini folder
!/.gemini/
# Ignore everything inside it
.gemini/*

# ❌ Secrets: never track, whatever the allowlists above say
#
# This block is LAST on purpose. .gitignore is last-match-wins, so these
# rules override the broad re-includes above (!/.config/omarchy/**,
# !/.config/hypr/**, !/.config/weechat/**, !.local/bin/**, and friends),
# which would otherwise sweep in any secret dropped into those trees.
#
# Caveat: ignore rules do NOT apply to files git already tracks. Adding a
# path here does nothing until you also run:
#     git rm --cached <path>
# And note that untracking does not erase it from pushed history.

# Known secret files
.config/restic/password
.config/weechat/sec.conf

# Secret-shaped names, anywhere in the tree. Deliberately broad: a config
# file wrongly ignored is an annoyance, a published key is not.
**/*password*
**/*passwd*
**/*secret*
**/*credential*
**/*token*
**/.env
**/.env.*
**/.netrc
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.age
**/*.gpg
**/*.kdbx
**/id_rsa*
**/id_dsa*
**/id_ecdsa*
**/id_ed25519*

# SSH: keys, known_hosts, and agent state stay out. The config is
# allowlisted near the top of this file and re-allowed here.
.ssh/*
!.ssh/config
