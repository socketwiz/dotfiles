#!/usr/bin/env python3
"""Dismiss the omarchy screensaver on real mouse activity.

The stock omarchy screensaver (org.omarchy.screensaver running `tte`) only exits
on a keypress or focus loss -- moving the mouse does nothing but reset hypridle's
idle timer, so the screensaver lingers on screen. Position polling can't fix this
reliably: omarchy-launch-screensaver performs software cursor warps at startup
(focus changes, cursor:invisible) that are indistinguishable from real movement,
so a position-based watcher dismisses the screensaver before it is ever seen.

This watcher instead reads evdev input events straight from the pointer devices
(/dev/input/event*). A physical mouse move/click/scroll emits a real input event;
the compositor's software warps do not. So only genuine input dismisses the
screensaver, and the launch-time warp can never trigger a false dismissal.

Requires read access to /dev/input (the user is in the `input` group).
"""

import glob
import os
import select
import subprocess
import time

SS = "org.omarchy.screensaver"


def screensaver_up():
    return subprocess.run(
        ["pgrep", "-f", SS], stdout=subprocess.DEVNULL
    ).returncode == 0


def kill_screensaver():
    subprocess.run(["pkill", "-x", "tte"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["pkill", "-f", SS],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def pointer_devices():
    """Event device paths whose /proc handler set includes a `mouseN` (pointers)."""
    paths = []
    try:
        with open("/proc/bus/input/devices") as f:
            for line in f:
                if line.startswith("H: Handlers=") and "mouse" in line:
                    for tok in line.split("=", 1)[1].split():
                        if tok.startswith("event"):
                            paths.append("/dev/input/" + tok)
    except OSError:
        pass
    # Fall back to every event device if parsing found nothing.
    return sorted(set(paths)) or sorted(glob.glob("/dev/input/event*"))


def open_devices():
    fds = []
    for path in pointer_devices():
        try:
            fds.append(os.open(path, os.O_RDONLY | os.O_NONBLOCK))
        except OSError:
            pass
    return fds


def drain(fds):
    """Discard events buffered before the screensaver appeared."""
    for fd in fds:
        try:
            while os.read(fd, 4096):
                pass
        except (BlockingIOError, OSError):
            pass


def main():
    while True:
        while not screensaver_up():
            time.sleep(1)

        fds = open_devices()
        drain(fds)

        moved = False
        while not moved and screensaver_up():
            ready, _, _ = select.select(fds, [], [], 0.5) if fds else ([], [], [])
            if not fds:
                time.sleep(0.5)
            for fd in ready:
                try:
                    if os.read(fd, 4096):
                        moved = True
                except (BlockingIOError, OSError):
                    pass

        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass

        if moved:
            kill_screensaver()

        while screensaver_up():
            time.sleep(0.5)


if __name__ == "__main__":
    main()
