#!/usr/bin/env bash
set -uo pipefail

#
# Repair a half-dead UNAS automount before something depends on it.
#
# macOS autofs (AUTOMOUNT_TIMEOUT=3600) tears the SMB session down after an
# hour idle, and the teardown does not always complete. What is left looks
# mounted -- `mount` still lists an smbfs entry for the path -- but every
# access returns "Permission denied", and `df` fails the same way. The tell is
# that the stale entry has lost its `mounted by <user>` attribute.
#
# That matters because the backup's BACKUP_REQUIRE_MOUNT guard resolves the
# device via `df`, so a stale mount reads as "not a mountpoint" and preflight
# refuses to run. The refusal is correct (it is what stops restic from
# initialising a phantom repo on the local disk) but it aborts BOTH the local
# and the offsite leg, and the nightly cron run is precisely the case where
# the share has been idle for hours.
#
# So: try the path, and only if it is unusable drop the session and let autofs
# mount it fresh. On a healthy mount this is a no-op.
#
# Usage: unas-heal [mountpoint ...]   (default: BOTH UNAS mounts)
#
# Defaults to both because they are separate SMB sessions that go stale
# independently. Healing only /opt/unas/personal, as an earlier version did,
# leaves /opt/unas/shared broken and the failure then looks like missing or
# corrupt data rather than a dead mount.
#
# Exit 0 if every mount is usable when we finish, 1 otherwise, so a caller can
# decide whether to continue.
#

if [[ $# -gt 0 ]]; then
    MOUNTS=("$@")
else
    MOUNTS=(/opt/unas/personal /opt/unas/shared)
fi

log() { printf '[%s] unas-heal: %s\n' "$(date '+%H:%M:%S')" "$*"; }

# Run "$@" with a hard deadline in seconds. Returns 124 on timeout, the way
# timeout(1) does. macOS ships no timeout(1) and coreutils is not installed
# here, so this is done by hand.
#
# This exists because probing a dead SMB mount does not always fail: on
# 2026-09-03 a real cron run sat on `ls /opt/unas/personal` for over 70 seconds
# and had to be killed. A hang is worse than an error, because `backup` never
# runs, so it never pings healthchecks and the night is lost in silence until
# the 6h grace expires, rather than alerting in five seconds.
#
# Deliberately polls with `kill -0` rather than using `wait`, and does NOT wait
# for the process to be reaped after SIGKILL. A task stuck in an
# uninterruptible kernel wait on an unresponsive share cannot be reaped, and
# `wait` would then block forever, reintroducing the very problem this is here
# to prevent. The cost is a possibly leaked process, which is the right trade.
with_timeout() {
    local secs="$1"; shift
    # Deliberately NO `set -m` here. A new process group would escape a group
    # kill aimed at this script by a caller (backup-cron's run_bounded), which
    # is how a hung `ls /opt/unas/shared` outlived its parent by 1h48m on
    # 2026-09-03. Staying in the caller's group means one kill up there reaps
    # this whole tree. Descendants are reaped explicitly below instead.
    "$@" &
    local pid=$!
    # Poll in 200ms ticks, not 1s: a healthy probe answers almost immediately
    # and this runs four times per invocation, so second-granularity polling
    # added ~4s of dead time to the common case.
    local waited=0 ticks=$((secs * 5))
    while kill -0 "$pid" 2>/dev/null; do
        if [[ $waited -ge $ticks ]]; then
            # Children first: the thing actually wedged on a dead share is the
            # `ls`, not the subshell that forked it. Killing the parent first
            # re-parents the child to init and pkill -P would then find nothing.
            pkill -9 -P "$pid" 2>/dev/null
            kill -9 "$pid" 2>/dev/null
            return 124
        fi
        sleep 0.2
        waited=$((waited + 1))
    done
    wait "$pid" 2>/dev/null
}

# Poll `usable` until it succeeds or the window expires. Used only on the slow
# path, after a forced unmount, where the mount legitimately needs time to come
# back. The healthy path still answers on the first probe and never waits.
wait_usable() {
    local deadline=$((SECONDS + UNAS_REMOUNT_WAIT))
    while :; do
        usable && return 0
        [[ $SECONDS -ge $deadline ]] && return 1
        sleep 3
    done
}

# How long to keep re-probing after EACH repair cycle before trying again.
#
# Sized against the retry loop, not on its own: three cycles of 45s give the
# mount 135s of total patience, more than the single 90s window it replaced,
# while keeping the pathological case (a path that will never come back) to a
# couple of minutes instead of ten. The measured successful remount took 23s.
UNAS_REMOUNT_WAIT="${UNAS_REMOUNT_WAIT:-45}"

# How many full unmount/remount cycles to try before giving up.
UNAS_REPAIR_ATTEMPTS="${UNAS_REPAIR_ATTEMPTS:-3}"

# Seconds allowed for any single mount probe or repair command.
#
# Generous on purpose. The bound exists to stop a wedged share hanging the run
# forever, NOT to judge how fast a healthy mount should answer. Measured from
# cron on 2026-09-03: a warm probe returns in 0s and a cold automount trigger in
# about 4s, but that was minutes after other activity. The 02:00 run is the
# coldest access of the day, and an earlier value of 20s risked mistaking a slow
# cold trigger for a dead mount, which then force-unmounts a perfectly good
# share and turns a working night into a failed one. Erring high costs nothing
# when healthy (the probe still returns in a few seconds) and only delays the
# failure alert when genuinely broken.
UNAS_OP_TIMEOUT="${UNAS_OP_TIMEOUT:-60}"

# Usable means the backup would accept this mount, not merely that the path
# lists or that it appears in `mount`.
#
# This MUST mirror is_mountpoint() in ~/.local/bin/backup, because that guard is
# what decides whether the backup runs at all. macOS has no mountpoint(1), so it
# falls back to comparing the device behind the path with the device behind its
# parent, using `df -P`. On a stale SMB session `df` returns "Permission denied"
# and yields no device, while a bare `ls` on the mountpoint can still succeed.
# Probing with `ls` alone therefore reported healthy, this script no-opped, and
# the backup died in preflight five seconds later. That is precisely what
# happened on 2026-09-02 and 2026-09-03: two nights with no snapshot and no log.
# A timeout counts as "not usable", which is what we want: a probe that hangs
# means the mount needs repair, so fall through to recovery.
usable() { with_timeout "$UNAS_OP_TIMEOUT" _probe_mount; }

_probe_mount() {
    # Touch the path first so autofs gets a chance to mount on demand; on an
    # idle-but-clean automount that alone is enough. Callers probe twice for
    # this reason, since the mount may not have settled by the time `df` runs.
    ls "$MP" >/dev/null 2>&1

    local dev parent_dev
    dev=$(df -P "$MP" 2>/dev/null | awk 'NR==2 {print $1}')
    parent_dev=$(df -P "$MP/.." 2>/dev/null | awk 'NR==2 {print $1}')
    [[ -n "$dev" && "$dev" != "$parent_dev" ]] || return 1

    # Then prove real I/O, because metadata is not enough.
    #
    # A half-dead SMB session answers `ls` and `df` from cached metadata while
    # every actual read or write blocks forever. On 2026-09-03 this script
    # declared a mount "recovered" on the strength of ls and df, handed it to
    # restic, and restic sat there for 36 minutes at 0% CPU having written a
    # zero-byte log. Nothing above this line would have caught that.
    #
    # Write, read back, and delete: the backup needs to write, so test writing.
    # If any step blocks, with_timeout kills the probe and the caller treats the
    # timeout as unusable, which is the correct verdict.
    local probe="$MP/.unas-heal-probe.$$"
    printf 'probe\n' > "$probe" 2>/dev/null || return 1
    local got
    got=$(cat "$probe" 2>/dev/null)
    rm -f "$probe" 2>/dev/null
    [[ "$got" == "probe" ]]
}

# The direct-map line in /etc/auto_master is what makes autofs consult
# /etc/auto_unas at all. Without it nothing mounts and the map file looks
# perfectly fine, which is a confusing place to end up.
#
# It has gone missing once already: on 2026-09-01 the file was back to an
# Aug 12 copy with the line absent, so the 02:00 backup found no mount and
# aborted before it even opened a log. Whatever restores it (an OS update, a
# migration step), re-adding it is cheap and idempotent, so just check.
ensure_auto_master() {
    [[ -f /etc/auto_master ]] || return 0
    if grep -qE '^/-[[:space:]]+auto_unas' /etc/auto_master; then
        return 0
    fi
    log "/etc/auto_master lost its auto_unas line, re-adding"
    printf '/-\t\t\tauto_unas\t-nobrowse,hidefromfinder\n' | sudo -n tee -a /etc/auto_master >/dev/null
    sudo -n automount -vc >/dev/null 2>&1 || true
    sleep 2
}

ensure_auto_master

rc=0
for MP in "${MOUNTS[@]}"; do
    # Touch the path first: on an idle-but-clean automount this alone triggers
    # the mount and nothing further is needed.
    usable
    if usable; then
        continue
    fi

    # Repair in up to UNAS_REPAIR_ATTEMPTS cycles, not one.
    #
    # A badly wedged session needs one umount -f to tear it down and a LATER
    # attempt to actually remount; the first cycle often only does the teardown.
    # Measured on 2026-09-03: the first cycle gave up at 14:44:47 after its full
    # window, and a second cycle minutes later recovered the same mount in 23
    # seconds. Every failing run that day got exactly one cycle. The one run that
    # succeeded did so only because the caller happened to invoke this script a
    # second time, which is far too subtle a thing to depend on.
    # Plain assignments, not `local`: this loop is at script top level, not
    # inside a function, and `local` there is a runtime error that leaves
    # `recovered` unset. Under `set -u` the failure branch then aborted the
    # whole script on an unbound variable, so a first mount that could not be
    # repaired would take the second one down with it, unprocessed.
    recovered=false
    attempt=1
    for (( attempt = 1; attempt <= UNAS_REPAIR_ATTEMPTS; attempt++ )); do
        log "$MP is not readable, attempting recovery ($attempt of $UNAS_REPAIR_ATTEMPTS)"

        if mount | grep -q "on $MP (smbfs"; then
            log "stale smbfs session present, forcing unmount"
            with_timeout "$UNAS_OP_TIMEOUT" sudo -n umount -f "$MP" >/dev/null 2>&1 ||
                log "umount -f failed or timed out, continuing"
        fi

        # Re-trigger. `automount -vc` flushes the map cache; it is not sufficient
        # on its own (it leaves the dead session attached) but it is useful after
        # the session has actually been dropped.
        with_timeout "$UNAS_OP_TIMEOUT" sudo -n automount -vc >/dev/null 2>&1 || true
        sleep 2

        # Re-probe on a window rather than once: re-establishing an SMB session
        # after a forced unmount is appreciably slower than probing a live one,
        # and judging it too early condemns a mount that would have come back.
        if wait_usable; then
            recovered=true
            break
        fi
    done

    if [[ "$recovered" == true ]]; then
        log "recovered, $MP is readable again"
    else
        log "FAILED to recover $MP after $UNAS_REPAIR_ATTEMPTS attempts"
        log "check the share is reachable and /etc/auto_unas has the current password"
        rc=1
    fi
done

exit $rc
