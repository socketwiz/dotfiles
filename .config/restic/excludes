/home/zolmok/.gradle
/home/zolmok/.rustup
/home/zolmok/.cargo/registry
/home/zolmok/.cargo/git
/home/zolmok/.m2/repository
/home/zolmok/go/pkg/mod
/home/zolmok/.local/share/pipx
/home/zolmok/.local/share/mise
/home/zolmok/.local/share/pnpm
/home/zolmok/.local/share/uv

