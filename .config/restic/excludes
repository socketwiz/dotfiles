# Shared restic excludes. Distributed to omarchy, omarchy-laptop and minipc
# (minipc's copy lives at /root/.config/restic/excludes).
#
# Pattern rules: a bare name with no slash matches that basename at ANY depth.
# A pattern starting with / is an absolute filesystem path. `*` does not cross
# a directory separator. Spaces are literal, no quoting needed.
#
# Everything here must be genuinely regenerable. When in doubt, keep it: the
# cost of storing a spare gigabyte is far lower than discovering at restore
# time that something was not actually reproducible.

# --- build artifacts and dependency trees, at any depth ---
node_modules
target
__pycache__
.venv
.cache

# --- language and tool caches, all re-fetchable from upstream ---
/home/zolmok/.npm
/home/zolmok/.gradle
/home/zolmok/.rustup
/home/zolmok/.cargo/registry
/home/zolmok/.cargo/git
/home/zolmok/.m2/repository
/home/zolmok/go/pkg/mod
/home/zolmok/.local/share/pipx
/home/zolmok/.local/share/mise
/home/zolmok/.local/share/pnpm
/home/zolmok/.local/share/uv

# --- SDKs and games: large and re-downloadable ---
/home/zolmok/Android
/home/zolmok/.local/share/Steam
/home/zolmok/.local/share/lutris
/home/zolmok/.local/share/umu

# --- Electron apps whose local state is cache over a cloud source of truth ---
/home/zolmok/.config/Notion
/home/zolmok/.config/discord
/home/zolmok/.config/vesktop
/home/zolmok/.config/Slack

# --- browsers: drop the caches, KEEP the profile (history, logins, extensions) ---
/home/zolmok/.config/google-chrome/*/Cache
/home/zolmok/.config/google-chrome/*/Code Cache
/home/zolmok/.config/google-chrome/*/GPUCache
/home/zolmok/.config/google-chrome/*/Service Worker/CacheStorage
/home/zolmok/.config/chromium/*/Cache
/home/zolmok/.config/chromium/*/Code Cache
/home/zolmok/.config/chromium/*/GPUCache

# --- scratch space ---
#
# .zshenv points TMPDIR at $HOME/tmp on Linux, because /tmp is tmpfs on these
# machines (desktop 16G, minipc 2.9G), so anything large written there is held
# in RAM. That redirect is deliberate and load bearing, but it drops every
# temp file this machine produces inside BACKUP_SOURCE.
#
# Left unexcluded it is pure waste: one Google Photos import in Aug 2026 put
# 17 GB of throwaway extract and staging into a snapshot tagged daily, weekly
# AND monthly, so restic would have carried it for six months. Nothing under
# here is worth a restore; if it were, it would not be in TMPDIR.
#
# Retention is handled separately by ~/.config/user-tmpfiles.d/home-tmp.conf,
# since systemd-tmpfiles only cleans /tmp, never a directory under $HOME.
/home/zolmok/tmp

# --- derived media (minipc) ---
#
# Gnomeflix keeps its data in /var/lib/gnomeflix, outside the source tree, so
# the repo can move without breaking the service. Of that, hls-assets is
# ~9.9 GB of HLS segments transcoded from video-assets, which is regenerable
# by re-running the import. video-assets itself is the 19 GB of source .mp4
# files and is NOT excluded: those are the originals and exist nowhere else.
#
# This path only exists on minipc; listing it here is harmless elsewhere and
# keeps the shared file the single source of truth, since minipc's root job
# reads a COPY at /root/.config/restic/excludes.
/var/lib/gnomeflix/hls-assets

# --- misc ---
.Trash-1000
